{
  "name": "LunaVerta",
  "short_name": "LunaVerta",
  "description": "Free PDF editor and file converter that runs in your browser. Edit, sign, merge, compress and redact PDFs, and convert images, Word, Excel, audio and video. Nothing is uploaded.",
  "id": "/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "background_color": "#e9ecf1",
  "theme_color": "#2f45c9",
  "lang": "en",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "icons/screen-wide-ring.webp",
      "sizes": "1600x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Drop a file and pick a format from the ring"
    },
    {
      "src": "icons/screen-wide-redact.webp",
      "sizes": "1600x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Remove ID numbers, bank details and e-mails from a PDF for good"
    },
    {
      "src": "icons/screen-wide-edit.webp",
      "sizes": "1600x900",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Edit text right inside a PDF"
    },
    {
      "src": "icons/screen-phone-home.webp",
      "sizes": "720x1280",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Convert and edit files without uploading them"
    },
    {
      "src": "icons/screen-phone-ring.webp",
      "sizes": "720x1280",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Pick a format from the ring"
    },
    {
      "src": "icons/screen-phone-tools.webp",
      "sizes": "720x1280",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "52 tools, with search"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp",
          ".gif",
          ".bmp",
          ".avif",
          ".svg",
          ".ico",
          ".heic",
          ".heif"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document": [
          ".docx"
        ],
        "text/markdown": [
          ".md",
          ".markdown"
        ],
        "text/plain": [
          ".txt"
        ],
        "text/csv": [
          ".csv"
        ],
        "text/tab-separated-values": [
          ".tsv"
        ],
        "application/json": [
          ".json"
        ],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [
          ".xlsx"
        ],
        "application/vnd.ms-excel": [
          ".xls"
        ],
        "application/vnd.oasis.opendocument.spreadsheet": [
          ".ods"
        ],
        "audio/*": [
          ".mp3",
          ".wav",
          ".ogg",
          ".oga",
          ".opus",
          ".flac",
          ".m4a",
          ".aac",
          ".weba"
        ],
        "video/*": [
          ".mp4",
          ".webm",
          ".mov",
          ".m4v",
          ".mkv"
        ],
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [
          ".pptx"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-new"
    ]
  },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "text/markdown",
            "text/plain",
            "text/csv",
            "text/tab-separated-values",
            "application/json",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "application/vnd.ms-excel",
            "application/vnd.oasis.opendocument.spreadsheet",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            "audio/*",
            "video/*",
            ".png",
            ".jpg",
            ".jpeg",
            ".webp",
            ".gif",
            ".bmp",
            ".avif",
            ".svg",
            ".ico",
            ".heic",
            ".heif",
            ".pdf",
            ".docx",
            ".md",
            ".markdown",
            ".txt",
            ".csv",
            ".tsv",
            ".json",
            ".xlsx",
            ".xls",
            ".ods",
            ".pptx",
            ".mp3",
            ".wav",
            ".ogg",
            ".oga",
            ".opus",
            ".flac",
            ".m4a",
            ".aac",
            ".weba",
            ".mp4",
            ".webm",
            ".mov",
            ".m4v",
            ".mkv"
          ]
        }
      ]
    }
  },
  "dir": "ltr",
  "orientation": "any",
  "shortcuts": [
    {
      "name": "Edit PDF",
      "url": "/edit-pdf/",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Merge PDF",
      "url": "/merge-pdf/",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Compress PDF",
      "url": "/compress-pdf/",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Remove sensitive information",
      "short_name": "Redact PDF",
      "url": "/redact-pdf/",
      "icons": [
        {
          "src": "icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
